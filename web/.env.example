# 复制为 .env 后按需修改
DJANGO_SECRET_KEY=dev-insecure-secret-change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=*

# 数据库：本地开发用 sqlite；上线用 mysql
DB_ENGINE=sqlite
# DB_ENGINE=mysql
# DB_NAME=bili_analyzer
# DB_USER=root
# DB_PASSWORD=你的密码
# DB_HOST=127.0.0.1
# DB_PORT=3306

# 数据目录（Windows 本地默认）
DATA_ROOT=E:\架构\data